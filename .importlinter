# Executable projection of this repository's layering ADRs.
#
# OWNERSHIP. This file states architecture, not implementation. Loosening it --
# adding an ignore_imports entry, deleting or weakening a contract, changing a
# layer order -- is an architecture decision and requires explicit user consent. Tightening it -- removing an
# ignore_imports entry, adding a contract -- needs no consent and is encouraged.
#
# ignore_imports is the ratchet baseline. It may shrink. It may not grow.

[importlinter]
root_package = zcu_tools

# ADR-0063: only an external composition root bootstraps concrete entry definitions.
[importlinter:contract:entry-definitions-composition-only]
name = C14: entry definitions are injected by the composition root, not imported by lib
type = forbidden
source_modules =
    zcu_tools
forbidden_modules =
    zcu_tools.resources.entry.builtin_kinds

[importlinter:contract:experiment-no-gui]
name = C1: the experiment domain does not depend on the GUI
type = forbidden
source_modules =
    zcu_tools.experiment
forbidden_modules =
    zcu_tools.gui
# zcu_tools.experiment.v2_gui is a GUI adapter that happens to live under
# experiment/. It is expected to import zcu_tools.gui; the domain modules beside
# it are not. Its 517 edges are excluded here rather than treated as debt.
ignore_imports =
    zcu_tools.experiment.v2_gui.** -> zcu_tools.gui.**
    zcu_tools.experiment.cfg_editing.** -> zcu_tools.gui.cfg

# D1: cfg_editing is experiment-side editing support; gui.cfg is a Qt-free
# generic framework. The endpoint is the gui.cfg package facade only.

# ADR-0067: shared session primitives cannot import app policy.
[importlinter:contract:session-no-app]
name = C2: shared session does not depend on apps
type = forbidden
source_modules =
    zcu_tools.gui.session
forbidden_modules =
    zcu_tools.gui.app

# ADR-0045: app-independent cfg core owns data and generic algorithms.
[importlinter:contract:cfg-core-no-domain]
name = C3: cfg core does not depend on app or experiment domain
type = forbidden
source_modules =
    zcu_tools.gui.cfg
forbidden_modules =
    zcu_tools.gui.app
    zcu_tools.experiment
    zcu_tools.resources

# ADR-0045: shared renderers receive policy through ports.
[importlinter:contract:cfg-widgets-no-runtime]
name = C4: cfg widgets do not depend on runtime policy
type = forbidden
source_modules =
    zcu_tools.gui.widgets.cfg
forbidden_modules =
    zcu_tools.gui.app
    zcu_tools.experiment
    zcu_tools.resources
    zcu_tools.gui.session
    zcu_tools.device
    zcu_tools.notebook

# ADR-0045: autofluxdep consumes shared owners, not the measure app.
[importlinter:contract:autofluxdep-no-main]
name = C5: autofluxdep does not depend on the measure app
type = forbidden
source_modules =
    zcu_tools.gui.app.autofluxdep
forbidden_modules =
    zcu_tools.gui.app.measure

# lib/zcu_tools/analysis/fluxdep/README.md: notebook and GUI are adapters of the
# analysis kernel (formerly ADR-0028).
[importlinter:contract:fluxdep-kernel-no-adapters]
name = C6: fluxdep kernel does not depend on its adapters
type = forbidden
source_modules =
    zcu_tools.analysis.fluxdep
forbidden_modules =
    zcu_tools.gui
    zcu_tools.notebook

# D1: cfg_editing may use the Qt-free generic gui.cfg only, not other GUI owners.
[importlinter:contract:cfg-editing-only-gui-cfg]
name = C7: experiment cfg editing depends only on the generic gui cfg core
type = forbidden
source_modules =
    zcu_tools.experiment.cfg_editing
forbidden_modules =
    zcu_tools.gui.app
    zcu_tools.gui.plotting
    zcu_tools.gui.remote
    zcu_tools.gui.session
    zcu_tools.gui.widgets
    zcu_tools.gui.controller_base
    zcu_tools.gui.error_messages
    zcu_tools.gui.event_bus
    zcu_tools.gui.expected_error
    zcu_tools.gui.launcher
    zcu_tools.gui.logging_setup
    zcu_tools.gui.owner
    zcu_tools.gui.project
    zcu_tools.gui.result_scope
    zcu_tools.gui.runtime
    zcu_tools.gui.version_table

# ---------------------------------------------------------------------------
# docs/adr/draft/module-boundaries.md: package roles and dependency direction.
# Debt baselines list exact module pairs, each group naming who removes it.
# Wildcards appear only for legitimate exceptions marked "not debt".
# ---------------------------------------------------------------------------

[importlinter:contract:layers]
name = C8: frontends over the experiment framework over capability modules
type = layers
layers =
    zcu_tools.gui : zcu_tools.notebook : zcu_tools.mcp
    zcu_tools.experiment
    zcu_tools.datafile : zcu_tools.device : zcu_tools.program : zcu_tools.analysis : zcu_tools.plotting : zcu_tools.simulate : zcu_tools.resources : zcu_tools.cfg_model : zcu_tools.utils : zcu_tools.progress_bar : zcu_tools.qick_remote
ignore_imports =
    # Not debt until D80 moves them to zcu_lab: GUI adapters living under experiment/ (see C1).
    zcu_tools.experiment.v2_gui.** -> zcu_tools.gui.**
    zcu_tools.experiment.cfg_editing.** -> zcu_tools.gui.cfg

[importlinter:contract:top-level-acyclic]
name = C9: top-level packages form no import cycle
type = acyclic_siblings
ancestors =
    zcu_tools
depth = 0
ignore_imports =
    # Not debt until D80 moves them to zcu_lab (see C1, C8).
    zcu_tools.experiment.v2_gui.** -> zcu_tools.gui.**
    zcu_tools.experiment.cfg_editing.** -> zcu_tools.gui.cfg
    # Debt, see C10.
    zcu_tools.resources.context.library -> zcu_tools.program.v2

[importlinter:contract:stateful-independent]
name = C10: stateful capability modules do not import each other
type = independence
modules =
    zcu_tools.program
    zcu_tools.resources
    zcu_tools.device
    zcu_tools.qick_remote
ignore_imports =
    # Debt: cfg schema moves to the cfg_model kernel; removed with storage-redesign's
    # module library and the zcu_lab move (stage 2).
    zcu_tools.resources.context.library -> zcu_tools.program.v2
    # Debt: program depends on cfg_model Protocols instead (stage 1, backlog).
    zcu_tools.program.v2.modules -> zcu_tools.resources.context
    zcu_tools.program.v2.modules.base -> zcu_tools.resources.context
    zcu_tools.program.v2.modules.waveform -> zcu_tools.resources.context
    zcu_tools.program.v2.modules.waveform -> zcu_tools.resources.waveform_assets
    zcu_tools.program.v2.sim.waveforms -> zcu_tools.resources.waveform_assets
    # Debt, see C12.
    zcu_tools.simulate.fluxonium.predict -> zcu_tools.resources.qubit_params

[importlinter:contract:cfg-kernel-external-only]
name = C11: the cfg_model kernel depends only on utils
type = forbidden
source_modules =
    zcu_tools.cfg_model
forbidden_modules =
    zcu_tools.analysis
    zcu_tools.datafile
    zcu_tools.device
    zcu_tools.experiment
    zcu_tools.gui
    zcu_tools.mcp
    zcu_tools.notebook
    zcu_tools.plotting
    zcu_tools.program
    zcu_tools.progress_bar
    zcu_tools.qick_remote
    zcu_tools.resources
    zcu_tools.simulate

[importlinter:contract:tools-no-stateful]
name = C12: stable tools do not depend on stateful capability modules
type = forbidden
source_modules =
    zcu_tools.analysis
    zcu_tools.datafile
    zcu_tools.plotting
    zcu_tools.progress_bar
    zcu_tools.simulate
    zcu_tools.utils
forbidden_modules =
    zcu_tools.device
    zcu_tools.program
    zcu_tools.qick_remote
    zcu_tools.resources
ignore_imports =
    # Debt: predict takes numeric parameters from its caller (backlog).
    zcu_tools.simulate.fluxonium.predict -> zcu_tools.resources.qubit_params

[importlinter:contract:mcp-remote-only]
name = C13: mcp uses only the GUI remote contract
type = forbidden
source_modules =
    zcu_tools.mcp
forbidden_modules =
    zcu_tools.gui
ignore_imports =
    # Not debt: the shared remote transport and each app's wire specs (ADR-0068).
    zcu_tools.mcp.** -> zcu_tools.gui.remote.**
    zcu_tools.mcp.** -> zcu_tools.gui.app.*.remote.**
    zcu_tools.mcp.** -> zcu_tools.gui.app.autofluxdep.services.remote.**
    # Debt: logging setup is not part of the remote contract (backlog).
    zcu_tools.mcp.measure.server -> zcu_tools.gui.logging_setup
