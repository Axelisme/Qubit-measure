# Executable projection of this repository's layering ADRs.
#
# OWNERSHIP. This file states architecture, not implementation. Loosening it --
# adding an ignore_imports entry, deleting or weakening a contract, changing a
# layer order -- is an architecture decision and requires explicit user consent. Tightening it -- removing an
# ignore_imports entry, adding a contract -- needs no consent and is encouraged.
#
# ignore_imports is the ratchet baseline. It may shrink. It may not grow.

[importlinter]
root_packages =
    zcu_tools
    zcu_lab
    migrations
    mcp_servers
include_external_packages = True

# Runtime code must not depend on offline data migration tools.
[importlinter:contract:runtime-no-migrations]
name = C20: zcu_tools does not depend on offline migrations
type = forbidden
source_modules =
    zcu_tools
forbidden_modules =
    migrations

# ADR-0063: only an external composition root bootstraps concrete entry definitions.
[importlinter:contract:entry-definitions-composition-only]
name = C14: entry definitions are injected by the composition root, not imported by lib
type = forbidden
source_modules =
    zcu_tools
forbidden_modules =
    zcu_lab.components

# Pydantic input tools may reuse Qt-free leaves, never host or execution policy.
[importlinter:contract:form-core-no-ui-policy]
name = Pydantic form core is Qt-free and has no host policy
type = forbidden
source_modules =
    zcu_tools.gui.form
forbidden_modules =
    zcu_tools.gui.app
    zcu_tools.gui.widgets
    zcu_tools.gui.remote
    zcu_tools.gui.session.services
    zcu_tools.gui.session.ui
    zcu_tools.gui.session.adapters
    zcu_tools.experiment
    qtpy
    PyQt5
    PyQt6
    PySide2
    PySide6

# The shared Form generator is a Qt-free frontend framework below every app host.
[importlinter:contract:form-adapter-no-host]
name = Shared Form generator is Qt-free and does not depend on app hosts
type = forbidden
source_modules =
    zcu_tools.gui.form_adapter
forbidden_modules =
    zcu_tools.gui.app
    zcu_tools.gui.widgets
    zcu_tools.gui.remote
    zcu_tools.gui.session.services
    zcu_tools.gui.session.ui
    zcu_tools.gui.session.adapters
    zcu_tools.experiment
    zcu_tools.mcp
    qtpy
    PyQt5
    PyQt6
    PySide2
    PySide6

# Pydantic form editor may render the draft, never own host or execution policy.
[importlinter:contract:form-editor-no-host]
name = Pydantic form editor does not depend on app or execution policy
type = forbidden
source_modules =
    zcu_tools.gui.widgets.form
forbidden_modules =
    zcu_tools.gui.app
    zcu_tools.gui.remote
    zcu_tools.experiment
    zcu_tools.mcp

# Named-workflow core has no frontend or Qt dependency, including external Qt roots.
[importlinter:contract:workflows-core-no-ui]
name = C18: named workflow execution does not depend on frontends or Qt
type = forbidden
source_modules =
    zcu_tools.experiment.workflows
forbidden_modules =
    zcu_tools.gui
    zcu_tools.mcp
    zcu_tools.notebook
    qtpy
    PyQt5
    PyQt6
    PySide2
    PySide6

[importlinter:contract:experiment-no-gui]
name = C1: the experiment domain does not depend on the GUI
type = forbidden
source_modules =
    zcu_tools.experiment
forbidden_modules =
    zcu_tools.gui


# ADR-0067: shared session primitives cannot import app policy.
[importlinter:contract:session-no-app]
name = C2: shared session does not depend on apps
type = forbidden
source_modules =
    zcu_tools.gui.session
forbidden_modules =
    zcu_tools.gui.app

# lib/zcu_tools/analysis/fluxdep/README.md: notebook and GUI are adapters of the
# analysis kernel (formerly ADR-0028).
[importlinter:contract:fluxdep-kernel-no-adapters]
name = C6: fluxdep kernel does not depend on its adapters
type = forbidden
source_modules =
    zcu_tools.analysis.fluxdep
forbidden_modules =
    zcu_tools.gui
    zcu_tools.notebook

# ---------------------------------------------------------------------------
# ADR-0072 (docs/adr/0072-module-boundaries.md): package roles and dependency direction.
# Debt baselines list exact module pairs, each group naming who removes it.
# Wildcards appear only for legitimate exceptions marked "not debt".
# ---------------------------------------------------------------------------

[importlinter:contract:layers]
name = C8: frontends over the experiment framework over capability modules
type = layers
layers =
    zcu_tools.gui : zcu_tools.notebook : zcu_tools.mcp
    zcu_tools.experiment
    zcu_tools.datafile : zcu_tools.device : zcu_tools.program : zcu_tools.analysis : zcu_tools.plotting : zcu_tools.simulate : zcu_tools.resources : zcu_tools.cfg_model : zcu_tools.core : zcu_tools.utils : zcu_tools.progress_bar : zcu_tools.qick_remote

[importlinter:contract:top-level-acyclic]
name = C9: top-level packages form no import cycle
type = acyclic_siblings
ancestors =
    zcu_tools
depth = 0

[importlinter:contract:stateful-independent]
name = C10: stateful capability modules do not import each other
type = independence
modules =
    zcu_tools.program
    zcu_tools.resources
    zcu_tools.device
    zcu_tools.qick_remote
ignore_imports =
    # Debt: program depends on cfg_model Protocols instead (stage 1, backlog).
    zcu_tools.program.v2.modules -> zcu_tools.resources.context
    zcu_tools.program.v2.modules.base -> zcu_tools.resources.context
    zcu_tools.program.v2.modules.waveform -> zcu_tools.resources.context
    # Debt, see C12.
    zcu_tools.simulate.fluxonium.predict -> zcu_tools.resources.qubit_params

[importlinter:contract:cfg-kernel-external-only]
name = C11: the cfg_model kernel depends only on utils and core.waveform_format
type = forbidden
source_modules =
    zcu_tools.cfg_model
forbidden_modules =
    zcu_tools.analysis
    zcu_tools.datafile
    zcu_tools.device
    zcu_tools.experiment
    zcu_tools.gui
    zcu_tools.mcp
    zcu_tools.notebook
    zcu_tools.plotting
    zcu_tools.program
    zcu_tools.progress_bar
    zcu_tools.qick_remote
    zcu_tools.resources
    zcu_tools.simulate

[importlinter:contract:tools-no-stateful]
name = C12: stable tools do not depend on stateful capability modules
type = forbidden
source_modules =
    zcu_tools.core
    zcu_tools.analysis
    zcu_tools.datafile
    zcu_tools.plotting
    zcu_tools.progress_bar
    zcu_tools.simulate
    zcu_tools.utils
forbidden_modules =
    zcu_tools.device
    zcu_tools.program
    zcu_tools.qick_remote
    zcu_tools.resources
ignore_imports =
    # Debt: predict takes numeric parameters from its caller (backlog).
    zcu_tools.simulate.fluxonium.predict -> zcu_tools.resources.qubit_params

# Stateless shared core does not depend on domain/runtime owners.
[importlinter:contract:core-utils-only]
name = C19: the shared core depends only on utils
type = forbidden
source_modules =
    zcu_tools.core
forbidden_modules =
    zcu_tools.analysis
    zcu_tools.cfg_model
    zcu_tools.datafile
    zcu_tools.device
    zcu_tools.experiment
    zcu_tools.gui
    zcu_tools.mcp
    zcu_tools.notebook
    zcu_tools.plotting
    zcu_tools.program
    zcu_tools.progress_bar
    zcu_tools.qick_remote
    zcu_tools.resources
    zcu_tools.simulate

[importlinter:contract:mcp-remote-only]
name = C13: mcp uses only the GUI remote contract
type = forbidden
source_modules =
    zcu_tools.mcp
forbidden_modules =
    zcu_tools.gui
ignore_imports =
    # Not debt: the shared remote transport and each app's wire specs (ADR-0068).
    zcu_tools.mcp.** -> zcu_tools.gui.remote.**
    zcu_tools.mcp.** -> zcu_tools.gui.app.*.remote.**
    # Debt: logging setup is not part of the remote contract (backlog).
    zcu_tools.mcp.measure.server -> zcu_tools.gui.logging_setup

# ADR-0067: shared interactive contracts sit below application policy.
[importlinter:contract:interactive-below-apps]
name = C17: application policies depend on shared interactive contracts, never the reverse
type = layers
layers =
    zcu_tools.gui.app
    zcu_tools.gui.interactive

# D72: concrete definitions are supplied by the external composition root.
[importlinter:contract:framework-no-user]
name = C16: the framework does not import the user experiment package
type = forbidden
source_modules =
    zcu_tools
forbidden_modules =
    zcu_lab

# ADR-0062: fluxdep science policy stays independent of frontend driving adapters.
[importlinter:contract:workflow-export-science-no-frontends]
name = Workflow export science does not import frontend owners
type = forbidden
source_modules =
    zcu_lab.workflows.coherence_fluxdep.lifetime_export
    zcu_tools.experiment.workflows.saved_run
    zcu_lab.workflows.coherence_fluxdep.export
    zcu_lab.workflows.mist_fluxdep.export
    zcu_lab.workflows.coherence_fluxdep.samples
forbidden_modules =
    zcu_tools.gui
    zcu_tools.mcp
    zcu_tools.notebook
    zcu_lab.workflows.coherence_fluxdep.form
    zcu_lab.workflows.coherence_fluxdep.t1_form
    zcu_lab.workflows.coherence_fluxdep.t2_form
    zcu_lab.workflows.mist_fluxdep.form
    zcu_lab.workflows.overnight.form
    zcu_lab.workflows.common.calibration_form
    zcu_lab.workflows.common.calibration_modules
    qtpy
    PyQt5
    PyQt6
    PySide2
    PySide6

# D75: experiment cores remain independent of all GUI attachments and helpers.
[importlinter:contract:user-core-no-gui]
name = C15: user experiment cores do not depend on the GUI
type = forbidden
source_modules =
    zcu_lab.v2.**.core
forbidden_modules =
    zcu_tools.gui

# ADR-0062: concrete calibration and lifetime policies stay below frontend driving adapters.
[importlinter:contract:workflow-science-no-frontends]
name = Workflow calibration and coherence science do not depend on frontend owners
type = forbidden
source_modules =
    zcu_lab.workflows.common.calibration
    zcu_lab.workflows.coherence_fluxdep.calibration
    zcu_lab.workflows.coherence_fluxdep.workflow
    zcu_lab.workflows.coherence_fluxdep.measurements
    zcu_lab.workflows.mist_fluxdep.workflow
    zcu_lab.workflows.coherence_fluxdep.t1
    zcu_lab.workflows.coherence_fluxdep.t2
forbidden_modules =
    zcu_tools.gui
    zcu_tools.mcp
    zcu_tools.notebook
    qtpy
    PyQt5
    PyQt6
    PySide2
    PySide6

# Committed scalar projection and drawing stay independent of frontend admission.
[importlinter:contract:trend-science-no-frontends]
name = Overnight trend science does not depend on frontend owners
type = forbidden
source_modules =
    zcu_lab.workflows.overnight.trend
forbidden_modules =
    zcu_tools.gui
    zcu_tools.mcp
    zcu_tools.notebook

[importlinter:contract:program-simulation-entry]
name = Program classes use the simulation entry, not frontend or adapter internals
type = forbidden
source_modules =
    zcu_tools.program.v2.base
    zcu_tools.program.v2.modular
    zcu_tools.program.v2.modules
    zcu_tools.program.v2.ir
    zcu_tools.program.v2.macro
    zcu_tools.program.v2.mocksoc
    zcu_tools.program.v2.utils
forbidden_modules =
    zcu_tools.program.v2.simulation.frontend
    zcu_tools.program.v2.simulation.timeline
    zcu_tools.program.v2.simulation.dependencies
    zcu_tools.program.v2.simulation.binding
    zcu_tools.program.v2.simulation.signals
    zcu_tools.program.v2.simulation.soc
allow_indirect_imports = True

# Shared artifact persistence owns formats and failures without any GUI dependency.
[importlinter:contract:artifacts-core-no-ui]
name = Artifact persistence is independent of GUI and Qt
type = forbidden
source_modules =
    zcu_tools.experiment.artifacts
forbidden_modules =
    zcu_tools.gui
    qtpy
    PyQt5
    PyQt6
    PySide2
    PySide6

# Artifact and writeback commands meet only at app composition. Both may use
# shared State, events and context without importing the other package directly.
[importlinter:contract:measure-artifacts-no-writeback]
name = Measure artifacts do not import writeback owners
type = forbidden
source_modules =
    zcu_tools.gui.app.measure.artifacts
forbidden_modules =
    zcu_tools.gui.app.measure.writeback
allow_indirect_imports = True

[importlinter:contract:measure-writeback-no-artifacts]
name = Measure writeback does not import artifact owners
type = forbidden
source_modules =
    zcu_tools.gui.app.measure.writeback
forbidden_modules =
    zcu_tools.gui.app.measure.artifacts
allow_indirect_imports = True
