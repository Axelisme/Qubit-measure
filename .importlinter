# Executable projection of this repository's layering ADRs.
#
# OWNERSHIP. This file states architecture, not implementation. Loosening it --
# adding an ignore_imports entry, deleting or weakening a contract, changing a
# layer order -- is an architecture decision and requires explicit user consent. Tightening it -- removing an
# ignore_imports entry, adding a contract -- needs no consent and is encouraged.
#
# ignore_imports is the ratchet baseline. It may shrink. It may not grow.

[importlinter]
root_package = zcu_tools

[importlinter:contract:experiment-no-gui]
name = C1: the experiment domain does not depend on the GUI
type = forbidden
source_modules =
    zcu_tools.experiment
forbidden_modules =
    zcu_tools.gui
# zcu_tools.experiment.v2_gui is a GUI adapter that happens to live under
# experiment/. It is expected to import zcu_tools.gui; the domain modules beside
# it are not. Its 517 edges are excluded here rather than treated as debt.
ignore_imports =
    zcu_tools.experiment.v2_gui.** -> zcu_tools.gui.**
    zcu_tools.experiment.cfg_editing.** -> zcu_tools.gui.cfg

# D1: cfg_editing is experiment-side editing support; gui.cfg is a Qt-free
# generic framework. The endpoint is the gui.cfg package facade only.

# ADR-0020: shared session primitives cannot import app policy.
[importlinter:contract:session-no-app]
name = C2: shared session does not depend on apps
type = forbidden
source_modules =
    zcu_tools.gui.session
forbidden_modules =
    zcu_tools.gui.app

# ADR-0045: app-independent cfg core owns data and generic algorithms.
[importlinter:contract:cfg-core-no-domain]
name = C3: cfg core does not depend on app or experiment domain
type = forbidden
source_modules =
    zcu_tools.gui.cfg
forbidden_modules =
    zcu_tools.gui.app
    zcu_tools.experiment
    zcu_tools.resources

# ADR-0045: shared renderers receive policy through ports.
[importlinter:contract:cfg-widgets-no-runtime]
name = C4: cfg widgets do not depend on runtime policy
type = forbidden
source_modules =
    zcu_tools.gui.widgets.cfg
forbidden_modules =
    zcu_tools.gui.app
    zcu_tools.experiment
    zcu_tools.resources
    zcu_tools.gui.session
    zcu_tools.device
    zcu_tools.notebook

# ADR-0045: autofluxdep consumes shared owners, not the measure app.
[importlinter:contract:autofluxdep-no-main]
name = C5: autofluxdep does not depend on the measure app
type = forbidden
source_modules =
    zcu_tools.gui.app.autofluxdep
forbidden_modules =
    zcu_tools.gui.app.measure

# lib/zcu_tools/analysis/fluxdep/README.md: notebook and GUI are adapters of the
# analysis kernel (formerly ADR-0028).
[importlinter:contract:fluxdep-kernel-no-adapters]
name = C6: fluxdep kernel does not depend on its adapters
type = forbidden
source_modules =
    zcu_tools.analysis.fluxdep
forbidden_modules =
    zcu_tools.gui
    zcu_tools.notebook

# D1: cfg_editing may use the Qt-free generic gui.cfg only, not other GUI owners.
[importlinter:contract:cfg-editing-only-gui-cfg]
name = C7: experiment cfg editing depends only on the generic gui cfg core
type = forbidden
source_modules =
    zcu_tools.experiment.cfg_editing
forbidden_modules =
    zcu_tools.gui.app
    zcu_tools.gui.plotting
    zcu_tools.gui.remote
    zcu_tools.gui.session
    zcu_tools.gui.widgets
    zcu_tools.gui.controller_base
    zcu_tools.gui.error_messages
    zcu_tools.gui.event_bus
    zcu_tools.gui.expected_error
    zcu_tools.gui.launcher
    zcu_tools.gui.logging_setup
    zcu_tools.gui.owner
    zcu_tools.gui.project
    zcu_tools.gui.result_scope
    zcu_tools.gui.runtime
    zcu_tools.gui.version_table
